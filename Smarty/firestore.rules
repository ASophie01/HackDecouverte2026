rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(userId) { return signedIn() && request.auth.uid == userId; }
    function member(fridgeId) {
      return signedIn() && exists(/databases/$(database)/documents/fridges/$(fridgeId)/members/$(request.auth.uid));
    }
    function memberAfter(fridgeId) {
      return signedIn() && getAfter(/databases/$(database)/documents/fridges/$(fridgeId)/members/$(request.auth.uid)).data.userId == request.auth.uid;
    }
    function validItem(data, itemId) {
      return data.keys().hasOnly(['id','name','quantity','unit','category','expiryDate','barcode','imageUrl'])
        && data.id == itemId && data.name is string && data.name.size() > 0
        && data.name.size() <= 200 && data.quantity is number
        && data.quantity > 0 && data.quantity <= 1000000000
        && data.unit is string && data.unit.size() > 0 && data.unit.size() <= 60
        && data.expiryDate is string && data.expiryDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Legacy data stays private. The new app only reads it for its one-time copy.
    match /users/{userId} {
      allow read: if own(userId);
      allow create: if own(userId)
        && request.resource.data.keys().hasOnly(['personalFridgeId','legacyImportedAt'])
        && memberAfter(request.resource.data.personalFridgeId);
      allow update: if own(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['personalFridgeId','legacyImportedAt'])
        && (!('personalFridgeId' in resource.data) || request.resource.data.personalFridgeId == resource.data.personalFridgeId)
        && memberAfter(request.resource.data.personalFridgeId);
      match /items/{itemId} {
        allow read, write: if own(userId);
      }
      match /cookedRecipes/{recipeId} {
        allow read, create: if own(userId);
      }
      match /fridges/{fridgeId} {
        allow read: if own(userId);
        allow create: if own(userId) && memberAfter(fridgeId)
          && request.resource.data.keys().hasOnly(['name','ownerId'])
          && request.resource.data.name == getAfter(/databases/$(database)/documents/fridges/$(fridgeId)).data.name
          && request.resource.data.ownerId == getAfter(/databases/$(database)/documents/fridges/$(fridgeId)).data.ownerId;
      }
    }

    match /fridges/{fridgeId} {
      allow get: if member(fridgeId);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name','ownerId','inviteCode'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.inviteCode.matches('^[A-F0-9]{32}$')
        && memberAfter(fridgeId)
        && getAfter(/databases/$(database)/documents/fridgeInvites/$(request.resource.data.inviteCode)).data.fridgeId == fridgeId;

      match /members/{userId} {
        allow get: if own(userId) || member(fridgeId);
        allow list: if member(fridgeId);
        allow create: if own(userId)
          && request.resource.data.keys().hasOnly(['userId','inviteCode'])
          && request.resource.data.userId == userId
          && (getAfter(/databases/$(database)/documents/fridges/$(fridgeId)).data.ownerId == userId
            || get(/databases/$(database)/documents/fridgeInvites/$(request.resource.data.inviteCode)).data.fridgeId == fridgeId);
      }
      match /items/{itemId} {
        allow read: if member(fridgeId);
        allow create, update: if memberAfter(fridgeId) && validItem(request.resource.data, itemId);
        allow delete: if member(fridgeId);
      }
      match /cookedRecipes/{recipeId} {
        allow read: if member(fridgeId);
        allow create: if member(fridgeId)
          && request.resource.data.keys().hasOnly(['cookedBy','title','servings','cookedAt'])
          && request.resource.data.cookedBy == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.servings is int
          && request.resource.data.servings >= 1 && request.resource.data.servings <= 8
          && request.resource.data.cookedAt == request.time;
      }
    }

    // Exact-code lookup only: no listing/guessing the collection of invitations.
    // Codes use 128 random bits and grant membership, so share only with intended members.
    match /fridgeInvites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && code.matches('^[A-F0-9]{32}$')
        && request.resource.data.keys().hasOnly(['fridgeId','name','ownerId'])
        && getAfter(/databases/$(database)/documents/fridges/$(request.resource.data.fridgeId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/fridges/$(request.resource.data.fridgeId)).data.inviteCode == code
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name == getAfter(/databases/$(database)/documents/fridges/$(request.resource.data.fridgeId)).data.name;
    }
  }
}
